{
	"name": "direktorat-it",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-04",
	"workers_dev": true,
	"routes": [
		{ "pattern": "it.kskgroup.web.id", "custom_domain": true }
	],
	"assets": {
		"directory": "./build",
		"binding": "ASSETS",
		"run_worker_first": ["/status.json"]
	},
	"vars": {
		"ORIGIN_STATUS_URL": "https://it-origin.kskgroup.web.id/status.json"
	}
}
