{
	"name": "direktorat-it",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-04",
	"workers_dev": true,
	"triggers": { "crons": ["* * * * *"] },
	"observability": { "enabled": true },
	"durable_objects": { "bindings": [{ "name": "MONITOR", "class_name": "PublicMonitor" }] },
	"migrations": [{ "tag": "public-monitor-v1", "new_sqlite_classes": ["PublicMonitor"] }],
	"routes": [{ "pattern": "it.kskgroup.web.id", "custom_domain": true }],
	"assets": {
		"directory": "./build",
		"binding": "ASSETS",
		"run_worker_first": ["/status.json"]
	},
	"vars": {
		"ORIGIN_STATUS_URL": "https://it-origin.kskgroup.web.id/status.json",
		"ALERT_EMAIL_FROM": "Direktorat IT <onboarding@resend.dev>",
		"ALERT_EMAIL_TO": "kskitdeveloper@gmail.com"
	}
}
